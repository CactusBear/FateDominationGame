[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/net/room_data_panel.gd" id="1"]

[node name="RoomDataPanel" type="PopupPanel"]
size = Vector2i(1000, 720)
script = ExtResource("1")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 0
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 24

[node name="Content" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Margin/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 28
text = "房间数据 · 房主本机条目"

[node name="Filter" type="HBoxContainer" parent="Margin/Content"]
layout_mode = 2

[node name="Search" type="LineEdit" parent="Margin/Content/Filter"]
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "搜索条目"

[node name="All" type="Button" parent="Margin/Content/Filter"]
layout_mode = 2
text = "选中搜索结果"

[node name="None" type="Button" parent="Margin/Content/Filter"]
layout_mode = 2
text = "取消搜索结果"

[node name="Entries" type="Tree" parent="Margin/Content"]
layout_mode = 2
custom_minimum_size = Vector2(0, 420)
size_flags_vertical = 3
hide_root = true
theme_override_font_sizes/font_size = 22

[node name="Budget" type="HBoxContainer" parent="Margin/Content"]
layout_mode = 2

[node name="Label" type="Label" parent="Margin/Content/Budget"]
layout_mode = 2
text = "数据校验时间预算"

[node name="Seconds" type="SpinBox" parent="Margin/Content/Budget"]
layout_mode = 2
min_value = 0.0
max_value = 3600.0
value = 30.0
suffix = "秒"

[node name="Status" type="RichTextLabel" parent="Margin/Content"]
layout_mode = 2
custom_minimum_size = Vector2(0, 70)
autowrap_mode = 2
text = "请选择本机条目"

[node name="Actions" type="HBoxContainer" parent="Margin/Content"]
layout_mode = 2

[node name="Apply" type="Button" parent="Margin/Content/Actions"]
layout_mode = 2
text = "校验并应用"

[node name="Close" type="Button" parent="Margin/Content/Actions"]
layout_mode = 2
text = "关闭"

[node name="RiskConfirmation" type="ConfirmationDialog" parent="."]
title = "静态风险预检"
ok_button_text = "确认使用所选数据"
cancel_button_text = "返回选择"

[node name="Report" type="RichTextLabel" parent="RiskConfirmation"]
custom_minimum_size = Vector2(760, 360)
theme_override_font_sizes/normal_font_size = 22
autowrap_mode = 3
