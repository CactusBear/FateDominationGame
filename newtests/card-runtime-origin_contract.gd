extends "res://tests/card_effect_runtime_test.gd"

## 只验原来源与真实对象身份，不为业务效果加能力字段或补票。
func run() -> void:
	setup(2)
	var old:SessionContext = fixture_context
	var template = named(GameData.loaded_servants, "cu_chulainn")
	var helper_card = skill_card("cu_chulainn", "gae_bolg_piercing_heart")
	check(helper_card != null and SessionGeneration.origin_of(helper_card).get("ok", false), "parent S0 helper returns real original-source card")
	check(not MasterManager.prepare_role_runtime(template, null).get("ok", false), "S0 rejects missing original source")
	var invalid := SessionContext.new()
	check(not MasterManager.prepare_role_runtime(template, invalid).get("ok", false), "S0 rejects unsigned original source")
	var prepared:Dictionary = MasterManager.prepare_role_runtime(template, fixture_context)
	check(prepared.get("ok", false), "S0 accepts legal original root")
	var card = named(prepared.object._specials.SKILLS, "gae_bolg_piercing_heart")
	var declaration = named(template._specials.SKILLS, "gae_bolg_piercing_heart")
	check(not is_same(card, declaration), "factory creates real runtime card identity distinct from template")
	var origin:Dictionary = SessionGeneration.origin_of(card)
	check(origin.get("ok", false) and is_same(origin.context.token(), fixture_context.token()), "runtime identity retains exact original token")
	for effect in card._effects:
		var owner = effect.from.get_ref() if effect.from is WeakRef else effect.from
		check(is_same(owner, card), "effect source is same real runtime card identity")
		check(effect.runtime_source_status().get("ok", false), "effect source receipt is current")
		check(EffectManager.register_effect(effect, 0), "register real source to same actual owner")
		check(effect._trigger_player_id == 0 and GameDataManager.get_player_data(0).self_effects.has(effect), "registration owner receipt matches actual member")
	check(not EffectManager.register_effect(card._effects[0], 1), "registration rejects moving original owner to another member")
	var before:Array = GameDataManager.get_player_data(0).dynamic_time_points.duplicate()
	TimePointChecker.dynamic_time_point(["origin_probe"], 0, card)
	check(GameDataManager.get_player_data(0).dynamic_time_points == before, "time point without original source fails closed")
	TimePointChecker.dynamic_time_point(["origin_probe"], 0, card, invalid)
	check(GameDataManager.get_player_data(0).dynamic_time_points == before, "time point with unsigned source fails closed")
	TimePointChecker.dynamic_time_point(["origin_probe"], 0, card, fixture_context)
	check(GameLog.query({"type":"time_point", "actor":0, "tags":["origin_probe"]}, null).size() == 1, "time point with original source reaches real member")
	var operation:Dictionary = GameProgress.start_progress_operation("sync_power", [0], fixture_context)
	check(operation.get("ok", false), "legal progress root accepts exact original context")
	var receipt:Dictionary = await GameProgress.wait_progress_operation(operation, false)
	check(receipt.get("ok", false) and receipt.get("completed", false), "legal progress root completed receipt consumed")
	setup(2)
	check(not MasterManager.prepare_role_runtime(template, old).get("ok", false), "S0 rejects old source after reset")
	check(not MasterManager.prepare_role_runtime(prepared.object, fixture_context).get("ok", false), "S0 never retickets old runtime graph")
	check(not EffectManager.register_effect(card._effects[0], 0), "registration rejects old same-ID card")
	var fresh_before:Array = GameDataManager.get_player_data(0).dynamic_time_points.duplicate()
	TimePointChecker.dynamic_time_point(["old_origin_probe"], 0, card, old)
	check(GameDataManager.get_player_data(0).dynamic_time_points == fresh_before, "old time point cannot enter new same-ID member")
	check(not GameProgress.start_progress_operation("sync_power", [0], old).get("ok", false), "progress root rejects old source")
	check(not GameProgress.start_progress_operation("sync_power", [0], null).get("ok", false), "progress root rejects missing source")
	print("RESULT checks=", checks, " failures=", failures)
	get_tree().quit(0 if failures.is_empty() else 1)
