      "embedded_config": {
        "sha256": "1d46a174ccc0c7e03424db2d0d18a1935416add34284c00db03681a1656bab74",
        "text": "; Fate Domination 独立服务端配置\n; 首次启动只生成文件并退出，检查路径与端口后再次启动。\n; 游戏流量由独立服务端处理；P2P 信令仅辅助直连，不转发对局流量。\n\n[server]\nserver_name = \"Fate Domination\"\nmotd = \"\"\n; 对外 UDP 端口。开启 P2P 信令时同时使用此 TCP 端口。\nbind_address = \"*\"\nport = 24680\n; 可改为管理员本机的数据目录，不接受客户端传入的磁盘路径。\ndata_root = \"data\"\nstorage_root = \"user://server_rooms\"\n; 客户端密钥身份登记库。默认启用；空字符串仅用于明确关闭身份认证。\n; 未开启白名单时自动登记，无需管理员逐人批准；白名单和权限保存在此库中。\nidentity_registry = \"user://server_players.json\"\nmax_rooms = 16\nmax_clients = 96\n; 房间子进程只监听本机回环地址，内部端口与对外端口独立。\ninternal_port_base = 52000\ninternal_port_count = 128\nstartup_seconds = 30.0\nrecord_matches = true\n; game 为独立游戏服务，relay 只交换 P2P 握手信令，两项可以并用。\nroles = [\"game\"]\n; 本机控制台请求目录，空字符串表示关闭。只授予可信本机用户写权限。\nconsole_dir = \"\"\n; 每个房间尚未清理的管理请求与完成回执总数上限。\nmax_room_control_requests = 128\n; 保存后关服等待时限。失败或超时保持网关运行，不强杀房间。\nshutdown_seconds = 30.0\n\n[data]\n; 两项必须一起声明。零秒不运行随机模拟，但不等于关闭此开关。\n; 初始数据仅作为候选，房主预检并确认后才发布给玩家。\nrandom_sim_enabled = true\nrandom_sim_budget_sec = 60.0\n\n[relay]\n; 仅在 roles 包含 relay 时监听；速率限制按每条真实连接计算。\nsignal_rate_limit = 32\nrooms_per_ip = 16\nmax_packet_bytes = 262144\nice_timeout_sec = 30.0\n; 只影响信令登记和后续握手，不断开已经建立的游戏直连。零表示不过期。\nroom_code_ttl_sec = 0.0\n; 十六进制字符数。短码更易猜中，公网部署应结合限流选择足够的长度。\nroom_code_length = 32\n"
      }
    },
