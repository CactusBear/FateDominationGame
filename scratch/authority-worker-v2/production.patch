+		var stale:Dictionary = report.duplicate(true)
+		stale[key] = 0 if key in ["pid", "port"] else "obsolete"
+		check(not Manager.valid_ready_report(room, stale), "拒绝过期就绪字段：" + key)
+	var missing:Dictionary = report.duplicate(true)
+	missing.capabilities = {}
+	check(not Manager.valid_ready_report(room,missing), "缺少能力声明不能就绪")
+	missing = report.duplicate(true)
+	missing.capabilities.process_restart_is_rollback = true
+	check(not Manager.valid_ready_report(room,missing), "杀进程不能冒充根事务回滚")
+	check(Manager.matches_instance(room,42,instance), "PID 与随机实例同时绑定")
+	check(not Manager.matches_instance(room,42,"ffffffffffffffffffffffffffffffff"), "相同 PID 不能冒充新实例")
+	check(not Manager.matches_instance(room,43,instance), "相同实例不能冒充其他 PID")
+	check(not Manager.valid_instance_id("../bad"), "实例标识拒绝路径文本")
+	check(Worker._valid_integer(52000,1,65535), "端口接受整数")
+	check(Worker._valid_integer(52000.0,1,65535), "JSON 整数浮点有效")
+	check(not Worker._valid_integer(52000.5,1,65535), "不截断损坏端口")
+	check(not Worker._valid_integer(INF,1,65535), "无穷端口无效")
+	check(not Worker._valid_integer(true,1,65535), "布尔端口无效")
+	check(Bootstrap._positive_integer(1.0,65535), "信令端口支持 JSON 数值")
+	check(not Bootstrap._positive_integer(0,65535), "信令端口拒绝零")
+	var manager = Manager.new()
+	manager.authority_host_mode = "relay"
+	check(manager.create_room("not-created",{},"res://data").is_empty(), "relay 不得创建规则进程")
