import os
from SCons.Script import ARGUMENTS, Default, Glob, SConscript

# godot-cpp 为构建依赖，路径由构建者显式传入，不包含在发行包中。
cpp_dir = ARGUMENTS.get("godot_cpp_dir")
if not cpp_dir:
# This extension is built only against the caller-selected, checked-in API tree.
    raise RuntimeError("Specify godot_cpp_dir pointing to the approved godot-cpp API tree")
if ARGUMENTS.get("precision", "single") != "single":
    raise RuntimeError("FateServerSignals requires the single-precision API declaration")
# The business sources use guarded C++ exceptions; do not inherit godot-cpp's
# size-oriented disabled-exception default as an accidental ABI/build policy.
ARGUMENTS["precision"] = "single"
ARGUMENTS["disable_exceptions"] = "false"
env = SConscript(cpp_dir + "/SConstruct")
env.Append(CPPPATH=["src"])
if env["platform"] == "windows":
    env.Append(LIBS=["bcrypt"])
    if env.get("use_mingw", False):
        env.Append(CPPDEFINES=[("_WIN32_WINNT", "0x0A000002")])
        env.Append(LINKFLAGS=["-static-libgcc", "-static-libstdc++", "-static"])
target_suffix = "." + env["target"] if env["platform"] == "windows" else ""
output_dir = ARGUMENTS.get("output_dir", "bin")
name = os.path.join(output_dir, "libfate_server_signals." + env["platform"] + target_suffix + "." + env["arch"] + env["SHLIBSUFFIX"])
library = env.SharedLibrary(name, source=Glob("src/*.cpp"))
env.NoCache(library)
Default(library)
